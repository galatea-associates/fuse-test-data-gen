# FUSE Test Data Generator - React Frontend .gitignore
# React-specific patterns for performance monitoring dashboard

# Dependencies and Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Production Build Artifacts
build/
dist/
out/
bundle/
static/

# Development Build Cache
.cache/
.vite/
.parcel-cache/
.next/
.nuxt/

# Environment Configuration Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing and Coverage
coverage/
.nyc_output/
test-results/
playwright-report/
.pytest_cache/
__tests__/__coverage__/
jest-coverage/

# IDE and Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# React Development Server
.eslintcache
.stylelintcache

# Runtime and Logs
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock

# Node.js Runtime Files
lib-cov/
coverage/
.grunt/
.lock-wscript/
.node_repl_history
.npm/
.eslintrc.cache

# Package Lock Files (keep package-lock.json but ignore others)
yarn.lock
pnpm-lock.yaml

# Temporary and OS Files
tmp/
temp/
.tmp/
*.tmp
.sass-cache/
connect.lock/
typings/

# React-specific Cache
.eslintcache
.stylelintcache

# React Testing Library
__tests__/__snapshots__/

# Webpack and Bundler Files
webpack-stats.json
.webpack/

# Recharts and D3 Build Artifacts
*.d3v*

# Storybook
storybook-static/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.test

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional stylelint cache
.stylelintcache

# SvelteKit build / generate output
.svelte-kit

# End of React Frontend .gitignore